function TeleportToBoss()
    local player = game.Players.LocalPlayer
    local char = player.Character
    if not char then
        player.CharacterAdded:Wait()
        char = player.Character
        task.wait(1)
    end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local bossPosition = CFrame.new(215.72, 1594.49, -4294.38)
        hrp.CFrame = bossPosition
        print("[📍] Teleportado para o Boss IMEDIATAMENTE!")
        return true
    end
    return false
end

function SendCreate()
    pcall(function()
        local bridge = game:GetService("ReplicatedStorage"):FindFirstChild("BridgeNet2")
        if bridge then
            local remote = bridge:FindFirstChild("dataRemoteEvent")
            if remote then
                local args = {
                    [1] = {
                        [1] = {
                            ["Event"] = "BossRushAction",
                            ["Action"] = "Create"
                        },
                        [2] = "\17"
                    }
                }
                remote:FireServer(unpack(args))
                print("[✓] CREATE enviado!")
            end
        end
    end)
end

function SendStart()
    pcall(function()
        local bridge = game:GetService("ReplicatedStorage"):FindFirstChild("BridgeNet2")
        if bridge then
            local remote = bridge:FindFirstChild("dataRemoteEvent")
            if remote then
                local args = {
                    [1] = {
                        [1] = {
                            ["Dungeon"] = 2394154405,
                            ["Action"] = "Start",
                            ["Diff"] = Config.Difficulty,
                            ["Event"] = "BossRushAction"
                        },
                        [2] = "\17"
                    }
                }
                remote:FireServer(unpack(args))
                print("[✓] START enviado! Dificuldade: " .. Config.Difficulty)
            end
        end
    end)
end

function ExecuteCreateAndStart()
    print("[▶] ===== EXECUTANDO CREATE + START =====")
    StatusLabel:Set("Status: Enviando CREATE...")
    SendCreate()
    task.wait(1)
    
    StatusLabel:Set("Status: Enviando START (" .. Config.Difficulty .. ")...")
    SendStart()
    
    local color = ""
    if Config.Difficulty == "Ultra" then
        color = "💜"
    elseif Config.Difficulty == "Chaotic" then
        color = "🌪️"
    elseif Config.Difficulty == "Nightmare" then
        color = "🌙"
    else
        color = "⚔️"
    end
    
    Rayfield:Notify({
        Title = color .. " Dungeon Iniciada!",
        Content = Config.Difficulty,
        Duration = 2
    })
    
    print("[▶] ===== DUNGEON " .. string.upper(Config.Difficulty) .. " INICIADA ===== ")
    StatusLabel:Set("Status: Dungeon em andamento...")
end

-- ============================================
-- FUNÇÃO DE REBIRTH
-- ============================================

function ExecuteRebirth()
    print("[🔄] Executando Rebirth...")
    
    pcall(function()
        local bridge = game:GetService("ReplicatedStorage"):FindFirstChild("BridgeNet2")
        if bridge then
            local remote = bridge:FindFirstChild("dataRemoteEvent")
            if remote then
                local args = {
                    [1] = {
                        [1] = {
                            ["Event"] = "RebirthPlayer"
                        },
                        [2] = "\17"
                    }
                }
                remote:FireServer(unpack(args))
                print("[✓] Rebirth executado com sucesso!")
                
                Rayfield:Notify({
                    Title = "🔄 Rebirth Executado!",
                    Content = "Você foi renascido!",
                    Duration = 3
                })
            else
                print("[❌] Remote 'dataRemoteEvent' não encontrado!")
            end
        else
            print("[❌] BridgeNet2 não encontrado!")
        end
    end)
end

-- ============================================
-- FUNÇÃO DE UPGRADE DE STATUS
-- ============================================

function ExecuteStatusUpgrade(points)
    local upgradePoints = points or Config.StatusPoints
    
    -- Limitar pontos ao máximo de 3000 (segurança extra)
    if upgradePoints > 3000 then
        upgradePoints = 3000
        print("[⚠️] Pontos limitados a 3000 (máximo permitido)")
    end
    
    print("[📊] Executando Upgrade de Status com " .. upgradePoints .. " pontos...")
    
    pcall(function()
        local bridge = game:GetService("ReplicatedStorage"):FindFirstChild("BridgeNet2")
        if bridge then
            local remote = bridge:FindFirstChild("dataRemoteEvent")
            if remote then
                local args = {
                    [1] = {
                        [1] = {
                            ["Stats"] = "PlayerExp",
                            ["Event"] = "StatsUp",
                            ["Points"] = upgradePoints
                        },
                        [2] = "\17"
                    }
                }
                remote:FireServer(unpack(args))
                print("[✓] Upgrade de Status executado com sucesso! Pontos gastos: " .. upgradePoints)
                
                -- Atualizar label com horário do último upgrade
                local currentTime = os.date("%H:%M:%S")
                LastUpgradeLabel:Set("⏱️ Último upgrade: " .. currentTime .. " (" .. upgradePoints .. " pts)")
                
                Rayfield:Notify({
                    Title = "📊 Status Upgrade!",
                    Content = "Gastou " .. upgradePoints .. " pontos em PlayerExp",
                    Duration = 2
                })
            else
                print("[❌] Remote 'dataRemoteEvent' não encontrado!")
            end
        else
            print("[❌] BridgeNet2 não encontrado!")
        end
    end)
end

-- ============================================
-- LOOP PRINCIPAL
-- ============================================

local loopActive = false
local lastRebirthTime = tick()
local lastStatusTime = tick()

task.spawn(function()
    print("[🎮] Script v24 carregado!")
    print("[⚔️] Dificuldades: Easy, Normal, Hard, Insane, Ultra, Chaotic, Nightmare")
    print("[🔄] Auto Rebirth configurável!")
    print("[📊] Auto Status com timer configurável!")
    print("[💰] Limite de pontos: 3000 por upgrade!")
    
    while true do
        local currentTime = tick()
        
        -- ===== SISTEMA DE AUTO REBIRTH =====
        if Config.AutoRebirth then
            local timeSinceLastRebirth = currentTime - lastRebirthTime
            
            if timeSinceLastRebirth >= Config.RebirthInterval then
                print("[🔄] Tempo esgotado! Executando rebirth...")
                ExecuteRebirth()
                lastRebirthTime = currentTime
            end
            
            local nextRebirth = Config.RebirthInterval - timeSinceLastRebirth
            if nextRebirth > 0 then
                local minutos = math.floor(nextRebirth / 60)
                local segundos = math.floor(nextRebirth % 60)
                NextRebirthLabel:Set(string.format("⏱️ Próximo rebirth: %02d:%02d", minutos, segundos))
                RebirthStatusLabel:Set(string.format("🔄 Rebirth: %02d:%02d", minutos, segundos))
            else
                NextRebirthLabel:Set("⏱️ Próximo rebirth: AGORA!")
                RebirthStatusLabel:Set("🔄 Rebirth: AGORA!")
            end
        else
            NextRebirthLabel:Set("⏱️ Próximo rebirth: Desativado")
            RebirthStatusLabel:Set("🔄 Rebirth: Desativado")
        end
        
        -- ===== SISTEMA DE AUTO STATUS =====
        if Config.AutoStatus then
            local timeSinceLastStatus = currentTime - lastStatusTime
            
            if timeSinceLastStatus >= Config.StatusInterval then
                print("[📊] Tempo esgotado! Executando upgrade de status...")
                ExecuteStatusUpgrade(Config.StatusPoints)
                lastStatusTime = currentTime
            end
            
            local nextStatus = Config.StatusInterval - timeSinceLastStatus
            if nextStatus > 0 then
                local minutos = math.floor(nextStatus / 60)
                local segundos = math.floor(nextStatus % 60)
                
                if minutos > 0 then
                    NextStatusLabel:Set(string.format("⏱️ Próximo upgrade: %02d:%02d", minutos, segundos))
                    StatusUpLabel:Set(string.format("📊 Auto Status: %02d:%02d", minutos, segundos))
                else
                    NextStatusLabel:Set(string.format("⏱️ Próximo upgrade: %02d segundos", segundos))
                    StatusUpLabel:Set(string.format("📊 Auto Status: %02ds", segundos))
                end
            else
                NextStatusLabel:Set("⏱️ Próximo upgrade: AGORA!")
                StatusUpLabel:Set("📊 Auto Status: AGORA!")
            end
        else
            NextStatusLabel:Set("⏱️ Próximo upgrade: Desativado")
            StatusUpLabel:Set("📊 Auto Status: Desativado")
        end
        
        -- ===== SISTEMA DE DUNGEON =====
        if Config.AutoStart then
            if not loopActive then
                loopActive = true
                print("[🔁] Loop ativado! Dificuldade: " .. Config.Difficulty)
                
                while Config.AutoStart do
                    print("[📍] Teleportando para o Boss AGORA MESMO...")
                    StatusLabel:Set("Status: Teleportando para o Boss...")
                    TeleportToBoss()
                    
                    Rayfield:Notify({
                        Title = "📍 Teleportado!",
                        Content = "Aguardando " .. Config.WaitTime .. " segundos para " .. Config.Difficulty,
                        Duration = 3
                    })
                    
                    print("[⏳] Aguardando " .. Config.WaitTime .. " segundos para enviar CREATE + START (" .. Config.Difficulty .. ")...")
                    StatusLabel:Set("Status: Aguardando " .. Config.WaitTime .. "s para iniciar " .. Config.Difficulty)
                    
                    local startTime = tick()
                    local elapsed = 0
                    
                    while elapsed < Config.WaitTime and Config.AutoStart do
                        local remaining = Config.WaitTime - elapsed
                        local minutos = math.floor(remaining / 60)
                        local segundos = remaining % 60
                        TimerLabel:Set(string.format("Timer: %02d:%02d", minutos, segundos))
                        
                        if math.floor(remaining) % 30 == 0 and remaining > 0 then
                            print("[⏳] Enviando comandos em " .. math.floor(remaining) .. " segundos (" .. Config.Difficulty .. ")")
                            StatusLabel:Set(string.format("Status: Enviando %s em %ds", Config.Difficulty, math.floor(remaining)))
                        end
                        
                        task.wait(1)
                        elapsed = tick() - startTime
                    end
                    
                    if Config.AutoStart then
                        print("[▶] Tempo esgotado! Enviando CREATE + START (" .. Config.Difficulty .. ")...")
                        ExecuteCreateAndStart()
                        
                        print("[⏳] Aguardando 5 segundos antes de teleportar novamente...")
                        StatusLabel:Set("Status: Aguardando 5s para recomeçar")
                        
                        for i = 5, 1, -1 do
                            if not Config.AutoStart then break end
                            StatusLabel:Set(string.format("Status: Recomeçando em %ds", i))
                            task.wait(1)
                        end
                    end
                end
            end
        else
            if loopActive then
                loopActive = false
                TimerLabel:Set("Timer: --")
                StatusLabel:Set("Status: Desativado")
                print("[⏸] Loop desativado!")
            end
        end
        
        task.wait(0.1)
    end
end)

