-- FUNÇÃO DE REBIRTH (TENTA TODOS OS FORMATOS)
-- ============================================

function ExecuteRebirth()
    print("[🔄] Executando Rebirth...")
    RebirthDebugLabel:Set("🔍 Executando rebirth...")
    
    local success = false
    local bridge = game:GetService("ReplicatedStorage"):FindFirstChild("BridgeNet2")
    
    if not bridge then
        print("[❌] BridgeNet2 não encontrado!")
        RebirthDebugLabel:Set("❌ BridgeNet2 não encontrado!")
        Rayfield:Notify({
            Title = "❌ Erro",
            Content = "BridgeNet2 não encontrado!",
            Duration = 3
        })
        return false
    end
    
    local remote = bridge:FindFirstChild("dataRemoteEvent")
    if not remote then
        print("[❌] dataRemoteEvent não encontrado!")
        RebirthDebugLabel:Set("❌ dataRemoteEvent não encontrado!")
        Rayfield:Notify({
            Title = "❌ Erro",
            Content = "dataRemoteEvent não encontrado!",
            Duration = 3
        })
        return false
    end
    
    -- Tentar formatos diferentes
    local formatos = {
        function()
            local args = {
                [1] = {
                    [1] = {
                        ["Event"] = "RebirthPlayer"
                    },
                    [2] = "\17"
                }
            }
            remote:FireServer(unpack(args))
        end,
        function()
            local args = {
                [1] = {
                    ["Event"] = "RebirthPlayer"
                }
            }
            remote:FireServer(unpack(args))
        end,
        function()
            remote:FireServer("RebirthPlayer")
        end,
        function()
            local args = {
                [1] = {
                    [1] = {
                        ["Event"] = "Rebirth"
                    },
                    [2] = "\17"
                }
            }
            remote:FireServer(unpack(args))
        end,
        function()
            remote:FireServer("Rebirth")
        end
    }
    
    for i, formato in ipairs(formatos) do
        local executed = pcall(function()
            formato()
        end)
        
        if executed then
            success = true
            print("[✅] Rebirth executado com formato " .. i)
            RebirthDebugLabel:Set("✅ Rebirth executado! Formato " .. i)
            
            Rayfield:Notify({
                Title = "🔄 Rebirth Executado!",
                Content = "Você foi renascido! (Formato " .. i .. ")",
                Duration = 3
            })
            break
        end
        task.wait(0.2)
    end
    
    if not success then
        print("[❌] Todos os formatos falharam!")
        RebirthDebugLabel:Set("❌ Todos os formatos falharam!")
        Rayfield:Notify({
            Title = "❌ Erro",
            Content = "Rebirth falhou! Teste os formatos manualmente.",
            Duration = 4
        })
    end
    
    return success
end

-- ============================================
-- FUNÇÃO DE UPGRADE DE STATUS
-- ============================================

function ExecuteStatusUpgrade(points)
    local upgradePoints = points or Config.StatusPoints
    
    if upgradePoints > 3000 then
        upgradePoints = 3000
    end
    
    print("[📊] Executando Upgrade de Status com " .. upgradePoints .. " pontos...")
    
    local success = false
    local bridge = game:GetService("ReplicatedStorage"):FindFirstChild("BridgeNet2")
    
    if bridge then
        local remote = bridge:FindFirstChild("dataRemoteEvent")
        if remote then
            local formatos = {
                function()
                    local args = {
                        [1] = {
                            [1] = {
                                ["Stats"] = "PlayerExp",
                                ["Event"] = "StatsUp",
                                ["Points"] = upgradePoints
                            },
                            [2] = "\17"
                        }
                    }
                    remote:FireServer(unpack(args))
                end,
                function()
                    local args = {
                        [1] = {
                            ["Stats"] = "PlayerExp",
                            ["Event"] = "StatsUp",
                            ["Points"] = upgradePoints
                        }
                    }
                    remote:FireServer(unpack(args))
                end,
                function()
                    remote:FireServer("StatsUp", "PlayerExp", upgradePoints)
                end
            }
            
            for i, formato in ipairs(formatos) do
                pcall(function()
                    formato()
                    success = true
                    print("[✓] Status upgrade executado com formato " .. i)
                    
                    local currentTime = os.date("%H:%M:%S")
                    LastUpgradeLabel:Set("⏱️ Último upgrade: " .. currentTime .. " (" .. upgradePoints .. " pts)")
                    
                    Rayfield:Notify({
                        Title = "📊 Status Upgrade!",
                        Content = "+" .. upgradePoints .. " pts em PlayerExp",
                        Duration = 2
                    })
                end)
                
                if success then break end
                task.wait(0.2)
            end
        end
    end
    
    if not success then
        print("[❌] Falha no upgrade de status!")
    end
end

