-- Loop do Status
task.spawn(function()
    while true do
        if Config.AutoStatus then
            local now = tick()
            local elapsed = now - lastStatusTime
            
            -- Atualizar timer
            local remaining = Config.StatusInterval - elapsed
            if remaining > 0 then
                local segundos = math.floor(remaining)
                StatusTimerLabel:Set(string.format("⏱️ Próximo upgrade: %02d segundos", segundos))
                StatusUpLabel:Set(string.format("📊 Status: %02ds", segundos))
            else
                StatusTimerLabel:Set("⏱️ Próximo upgrade: AGORA!")
                StatusUpLabel:Set("📊 Status: AGORA!")
            end
            
            -- Executar se chegou o momento
            if elapsed >= Config.StatusInterval then
                print("[Loop Status] Executando upgrade programado...")
                ExecuteStatusUpgrade()
                lastStatusTime = tick()
            end
        else
            StatusTimerLabel:Set("⏱️ Próximo upgrade: Desativado")
            StatusUpLabel:Set("📊 Status: Desativado")
        end
        task.wait(1)
    end
end)

-- Loop do Rebirth
