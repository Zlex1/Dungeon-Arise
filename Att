-- FUNÇÃO DE STATUS (SIMPLIFICADA)
-- ============================================

function ExecuteStatusUpgrade()
    local points = Config.StatusPoints
    print("[Status] Tentando upgrade com " .. points .. " pontos...")
    
    local success = false
    local bridge = game:GetService("ReplicatedStorage"):FindFirstChild("BridgeNet2")
    
    if bridge then
        local remote = bridge:FindFirstChild("dataRemoteEvent")
        if remote then
            -- Tentar apenas o formato que funcionava antes
            local args = {
                [1] = {
                    [1] = {
                        ["Stats"] = "PlayerExp",
                        ["Event"] = "StatsUp",
                        ["Points"] = points
                    },
                    [2] = "\17"
                }
            }
            
            pcall(function()
                remote:FireServer(unpack(args))
                success = true
                print("[Status] ✅ Upgrade executado! +" .. points .. " pts")
                
                local hora = os.date("%H:%M:%S")
                StatusLastLabel:Set("📊 Último upgrade: " .. hora .. " (+" .. points .. " pts)")
                
                Rayfield:Notify({
                    Title = "📊 Status Upgrade!",
                    Content = "+" .. points .. " pontos em PlayerExp",
                    Duration = 2
                })
            end)
        else
            print("[Status] ❌ Remote não encontrado!")
        end
    else
        print("[Status] ❌ BridgeNet2 não encontrado!")
    end
    
    if not success then
        print("[Status] ❌ Falha no upgrade!")
        StatusLastLabel:Set("📊 Último upgrade: FALHOU!")
    end
    
    return success
end

