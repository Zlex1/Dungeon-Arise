local ConfigFileName = "DungeonHub_Config.json"
local HttpService = game:GetService("HttpService")

local Config = {
    AutoStart = false,
    Difficulty = "Easy",
    WaitTime = 120,  -- Tempo de espera DEPOIS do teleporte
    AutoRebirth = false,
    RebirthInterval = 300,  -- Tempo entre rebirths (segundos)
    AutoStatus = false,
    StatusInterval = 10,  -- Tempo entre upgrades (segundos)
    StatusPoints = 250   -- Quantos pontos gastar por vez
}

local function SaveConfig()
    if writefile then
        pcall(function() writefile(ConfigFileName, HttpService:JSONEncode(Config)) end)
    end
end

local function LoadConfig()
    if isfile and isfile(ConfigFileName) then
        pcall(function()
            local data = HttpService:JSONDecode(readfile(ConfigFileName))
            for k,v in pairs(data) do Config[k] = v end
        end)
    end
end
LoadConfig()

