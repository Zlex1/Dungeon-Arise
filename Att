function FindAllRemotes()
    print("[🔍] Procurando remotes...")
    local replicatedStorage = game:GetService("ReplicatedStorage")
    local bridge = replicatedStorage:FindFirstChild("BridgeNet2")
    
    if bridge then
        BridgeInfoLabel:Set("🌉 BridgeNet2: ENCONTRADO ✅")
        RemoteStatusLabel:Set("✅ BridgeNet2 encontrado!")
        print("[✅] BridgeNet2 encontrado!")
        
        local children = bridge:GetChildren()
        print("[📋] Total de filhos: " .. #children)
        
        for _, child in ipairs(children) do
            print("   - " .. child.Name .. " (" .. child.ClassName .. ")")
            if child.ClassName == "RemoteEvent" then
                RemoteStatusLabel:Set("🔍 RemoteEvent encontrado: " .. child.Name)
                print("[🎯] RemoteEvent disponível: " .. child.Name)
            end
        end
        
        local remote = bridge:FindFirstChild("dataRemoteEvent")
        if remote then
            RemoteStatusLabel:Set("✅ dataRemoteEvent encontrado! Pronto para uso.")
            print("[✅] dataRemoteEvent encontrado!")
        else
            RemoteStatusLabel:Set("⚠️ dataRemoteEvent não encontrado! Verificando alternativas...")
            print("[⚠️] dataRemoteEvent não encontrado!")
            
            -- Procurar alternativas
            for _, child in ipairs(children) do
                if child.ClassName == "RemoteEvent" then
                    RemoteStatusLabel:Set("🔍 Remote alternativo: " .. child.Name)
                    print("[🔍] Remote alternativo disponível: " .. child.Name)
                    break
                end
            end
        end
    else
        BridgeInfoLabel:Set("🌉 BridgeNet2: NÃO ENCONTRADO ❌")
        RemoteStatusLabel:Set("❌ BridgeNet2 não encontrado!")
        print("[❌] BridgeNet2 não encontrado!")
        
        -- Procurar em outros lugares
        print("[🔍] Procurando em ReplicatedStorage...")
        for _, child in ipairs(replicatedStorage:GetChildren()) do
            if child.Name:lower():find("bridge") or child.Name:lower():find("remote") then
                print("   - Possível remote: " .. child.Name .. " (" .. child.ClassName .. ")")
                RemoteStatusLabel:Set("🔍 Possível remote: " .. child.Name)
            end
        end
    end
end

function ListBridgeNet2()
    local bridge = game:GetService("ReplicatedStorage"):FindFirstChild("BridgeNet2")
    if bridge then
        print("[📋] ===== BridgeNet2 Content =====")
        for i, child in ipairs(bridge:GetChildren()) do
            print(i .. ". " .. child.Name .. " (" .. child.ClassName .. ")")
        end
        print("[📋] =============================")
        Rayfield:Notify({
            Title = "Debug",
            Content = "Listagem no console (F9)",
            Duration = 3
        })
    else
        print("[❌] BridgeNet2 não encontrado!")
        Rayfield:Notify({
            Title = "Erro",
            Content = "BridgeNet2 não encontrado!",
            Duration = 3
        })
    end
end

